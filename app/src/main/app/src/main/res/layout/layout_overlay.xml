<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="12dp">

    <!-- Header Panel Neon Transformers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="bimapr239 soundboard"
            android:textColor="#FFCC00"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnClose"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:text="X"
            android:textSize="10sp"
            android:backgroundTint="#FF0055" />
    </LinearLayout>

    <!-- Tombol Upload & List Sound -->
    <Button
        android:id="@+id/btnAddSound"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="+ Tambah MP3"
        android:textSize="12sp"
        android:backgroundTint="#FFCC00"
        android:textColor="#000000" />

    <!-- List Tombol Suara (Play 1x / Stop 1x) -->
    <LinearLayout
        android:id="@+id/soundContainer"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

</LinearLayout>
